<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Ta.Translate</RootNamespace>

    <!-- 文字栅格化的遮罩混合需要直接读写像素指针（BlendInto）。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ta.Core\Ta.Core.csproj" />
    <ProjectReference Include="..\Ta.Platform\Ta.Platform.csproj" />

    <!-- 仅用于 VisionProviderKind（Provider 协议种类枚举）；
         本模块的 HTTP 调用全部走自己定义的 ITranslationClient 抽象。 -->
    <ProjectReference Include="..\Ta.AI\Ta.AI.csproj" />
  </ItemGroup>
</Project>