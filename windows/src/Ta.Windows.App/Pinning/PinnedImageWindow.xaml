<Window x:Class="Ta.Windows.App.Pinning.PinnedImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480"
        Height="340"
        MinWidth="180"
        MinHeight="120"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#F7FFFFFF"
        MouseLeftButtonDown="Window_OnMouseLeftButtonDown"
        PreviewMouseWheel="Window_OnMouseWheel">
    <Border BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image x:Name="PinnedImage" Grid.Row="0" Stretch="Uniform" />
            <Border Grid.Row="1" Background="#F1F5F9" Padding="8">
                <StackPanel Orientation="Horizontal">
                    <Button Padding="12,7" Margin="0" Click="CopyButton_OnClick" Content="复制" />
                    <TextBlock Margin="14,0,8,0" VerticalAlignment="Center" Text="透明度" Foreground="#475569" />
                    <Slider x:Name="OpacitySlider"
                            Width="120"
                            Minimum="0.25"
                            Maximum="1"
                            Value="1"
                            TickFrequency="0.05"
                            ValueChanged="OpacitySlider_OnValueChanged" />
                    <Button Padding="12,7" Margin="16,0,0,0" Click="CloseButton_OnClick" Content="关闭" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="PinStatusText"
                       Grid.Row="2"
                       Visibility="Collapsed"
                       Padding="9,6"
                       TextWrapping="Wrap"
                       Background="#FEF3F2"
                       Foreground="#B42318" />
        </Grid>
    </Border>
</Window>
