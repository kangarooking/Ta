<Window x:Class="Ta.Windows.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拓 · Windows 设置"
        Width="760"
        Height="760"
        MinWidth="680"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="设置"
                       FontFamily="Segoe UI Semibold"
                       FontSize="28"
                       Foreground="#111827" />
            <TextBlock Margin="0,6,0,0"
                       Text="快捷键即时重新注册；API Key 加密保存在 Windows 凭据管理器。"
                       Foreground="#667085" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10" Padding="22">
                    <StackPanel>
                        <TextBlock Text="全局快捷键"
                                   TextAlignment="Center"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="17" />
                        <TextBlock Margin="0,14,0,5" Text="智能识图" Foreground="#475467" />
                        <TextBox x:Name="SmartTextShortcutTextBox" Padding="10,8" />
                        <TextBlock Margin="0,12,0,5" Text="区域截图" Foreground="#475467" />
                        <TextBox x:Name="RegionShortcutTextBox" Padding="10,8" />
                        <TextBlock Margin="0,12,0,5" Text="活动窗口截图" Foreground="#475467" />
                        <TextBox x:Name="WindowShortcutTextBox" Padding="10,8" />
                        <TextBlock Margin="0,12,0,5" Text="全屏截图" Foreground="#475467" />
                        <TextBox x:Name="FullDesktopShortcutTextBox" Padding="10,8" />
                        <TextBlock Margin="0,12,0,5" Text="重复区域" Foreground="#475467" />
                        <TextBox x:Name="RepeatRegionShortcutTextBox" Padding="10,8" />
                        <TextBlock Margin="0,9,0,0"
                                   Text="格式示例：Shift+A、Ctrl+Alt+Shift+1。至少包含一个修饰键。"
                                   FontSize="12"
                                   Foreground="#667085" />
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10" Padding="22">
                    <StackPanel>
                        <TextBlock Text="自动保存"
                                   TextAlignment="Center"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="17" />
                        <CheckBox x:Name="AutoSaveCheckBox"
                                  Margin="0,16,0,8"
                                  Content="截图后自动保存并复制完整文件路径" />
                        <CheckBox x:Name="ShowResultWindowCheckBox"
                                  Margin="0,4,0,10"
                                  Checked="ShowResultWindowCheckBox_OnChanged"
                                  Unchecked="ShowResultWindowCheckBox_OnChanged"
                                  Content="截图后显示结果窗口" />
                        <CheckBox x:Name="HideApplicationDuringCaptureCheckBox"
                                  Margin="0,4,0,10"
                                  Content="截图时隐藏拓的界面" />
                        <TextBlock Margin="0,4,0,5" Text="临时目录" Foreground="#475467" />
                        <TextBox x:Name="TemporaryDirectoryTextBox" Padding="10,8" />
                        <TextBlock Margin="0,9,0,0"
                                   Text="不会自动删除目录中的截图。私密模式不会自动保存或复制路径。"
                                   FontSize="12"
                                   Foreground="#667085" />
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10" Padding="22">
                    <StackPanel>
                        <TextBlock Text="AI 视觉识图"
                                   TextAlignment="Center"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="17" />
                        <TextBlock Margin="0,14,0,5" Text="Base URL" Foreground="#475467" />
                        <TextBox x:Name="VisionBaseUrlTextBox" Padding="10,8" />
                        <TextBlock Margin="0,12,0,5" Text="API Key" Foreground="#475467" />
                        <PasswordBox x:Name="VisionApiKeyPasswordBox" Padding="10,8" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="密码框为空时保留原 Key；输入新值会覆盖凭据管理器中的旧值。"
                                   FontSize="12"
                                   Foreground="#667085" />
                        <TextBlock Margin="0,12,0,5" Text="模型名称" Foreground="#475467" />
                        <TextBox x:Name="VisionModelTextBox" Padding="10,8" />
                        <TextBlock Margin="0,12,0,5" Text="识图任务指令" Foreground="#475467" />
                        <TextBox x:Name="VisionTaskPromptTextBox"
                                 MinHeight="92"
                                 Padding="10,8"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="超时秒数" Foreground="#475467" />
                                <TextBox x:Name="VisionTimeoutTextBox" Margin="0,5,0,0" Padding="8" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="最长边像素" Foreground="#475467" />
                                <TextBox x:Name="VisionMaximumDimensionTextBox" Margin="0,5,0,0" Padding="8" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="JPEG 质量" Foreground="#475467" />
                                <TextBox x:Name="VisionJpegQualityTextBox" Margin="0,5,0,0" Padding="8" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,10,0,0"
                                   Text="触发智能识图会把当前选区的压缩副本发送到上述服务。普通截图不会调用云端。"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="#B54708" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button Click="SaveButton_OnClick" Content="保存设置" />
            <Button Margin="10,0,0,10" Click="CloseButton_OnClick" Content="关闭" />
        </StackPanel>

        <Border Grid.Row="6"
                Padding="12,9"
                Background="#EFF6FF"
                BorderBrush="#BFDBFE"
                BorderThickness="1"
                CornerRadius="7">
            <TextBlock x:Name="StatusText"
                       Text="修改后点击保存。快捷键冲突时不会覆盖当前有效设置。"
                       TextWrapping="Wrap"
                       Foreground="#1D4ED8" />
        </Border>
    </Grid>
</Window>
